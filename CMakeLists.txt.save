cmake_minimum_required(VERSION 3.16)
project(ChronosDB C)

set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -O3 -Wall -Wextra -pthread")

include_directories(include)

find_package(OpenSSL REQUIRED)

add_library(chronos_static STATIC src/chronos.c)
target_link_libraries(chronos_static PRIVATE OpenSSL::Crypto pthread)

add_executable(chronos_db src/main.c)
target_link_libraries(chronos_db PRIVATE chronos_static)

add_executable(test_concurrency tests/test_concurrency.c)
target_link_libraries(test_concurrency PRIVATE chronos_static)
add_executable(test_benchmark tests/test_benchmark.c)
target_link_libraries(test_benchmark PRIVATE chronos_static OpenSSL::Crypto Threads::Threads)

clear
cd ~/chronos-db/build
rm -rf * .cmake CMakeCache.txt
cmake ..
make
./test_benchmark

